# Leave DATABASE_URL unset for local development: web and admin use an embedded
# Postgres (PGlite) stored in ./.pglite that migrates and seeds itself.
# Local sign-in: admin@listgate.local / listgate-dev (plus a demo agency and the starter partners).
# Set it to use a real Postgres, e.g. the DigitalOcean managed cluster:
# DATABASE_URL=postgresql://user:pass@host:25060/listgate?sslmode=require

APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ROOT_DOMAIN=listgate.com.au
# Listgate staff: admin site access.
ADMIN_EMAILS=
# CONTACT_EMAIL=hello@listgate.com.au
# SUPPORT_EMAIL=colin@alfalfa.com.au   # where new tickets are emailed (defaults to ADMIN_EMAILS)

# Email (Resend, same as Propchat). Without SMTP_URL nothing is sent; links are shown to copy.
# SMTP_URL=smtps://resend:re_xxx@smtp.resend.com:465
# EMAIL_FROM=Listgate <hello@listgate.com.au>

# Feeds
# MAX_FEED_MB=25
# FTP_HOST=ftp.listgate.com.au        # shown to agencies
# FTP_RELAY_KEY=                      # long random string; the FTP receiver sends it with every file

# Partner pushes: the web app checks for due deliveries this often (seconds). 0 turns the loop off.
# DELIVER_EVERY_SECONDS=15

# Seed the demo agency against a real database too
# SEED_DEMO=1
